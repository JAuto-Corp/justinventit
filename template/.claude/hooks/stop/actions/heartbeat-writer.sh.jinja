#!/usr/bin/env bash
{% if orchestration_tier == 'cluster' and external_pacemaker != 'none' -%}
# PRODUCER half: turn-end heartbeat; the shared command preserves intent and bounds lock wait.
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd)" || exit 0
bash "$ROOT/scripts/heartbeat-hook.sh" || printf 'heartbeat target unavailable; intent unchanged\n' >&2
exit 0
{% else -%}
# INERT in this project: solo/none explicit no-op; no supervisor has been selected.
exit 0
{% endif -%}
